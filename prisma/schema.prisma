generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum MarketStatus {
  DRAFT
  OPEN
  CLOSED
  RESOLVED
  VOID
}

enum Outcome {
  YES
  NO
}

enum LedgerType {
  INITIAL_CREDIT
  BET_STAKE
  BET_PAYOUT
  REFUND
  ADMIN_ADJUSTMENT
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  role          Role      @default(USER)
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  wallet        Wallet?
  bets          Bet[]
  ledgerEntries LedgerEntry[]
  resolutions   MarketResolution[] @relation("AdminResolutions")
  auditEvents   AuditEvent[]
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Market {
  id          String            @id @default(uuid())
  slug        String            @unique
  question    String
  description String?
  rules       String?
  category    String
  status      MarketStatus      @default(DRAFT)
  closesAt    DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  bets        Bet[]
  resolution  MarketResolution?
  ledgers     LedgerEntry[]
  auditEvents AuditEvent[]
}

model Bet {
  id             String   @id @default(uuid())
  userId         String
  marketId       String
  outcome        Outcome
  amount         Int
  createdAt      DateTime @default(now())
  idempotencyKey String

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  market        Market        @relation(fields: [marketId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]

  @@unique([userId, idempotencyKey])
}

model LedgerEntry {
  id       String  @id @default(uuid())
  userId   String
  marketId String?
  betId    String?

  amount    Int
  type      LedgerType
  createdAt DateTime   @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  market Market? @relation(fields: [marketId], references: [id], onDelete: SetNull)
  bet    Bet?    @relation(fields: [betId], references: [id], onDelete: SetNull)
}

model MarketResolution {
  id          String   @id @default(uuid())
  marketId    String   @unique
  outcome     Outcome
  evidenceUrl String?
  notes       String?
  resolvedBy  String
  resolvedAt  DateTime @default(now())

  market Market @relation(fields: [marketId], references: [id], onDelete: Restrict)
  admin  User   @relation("AdminResolutions", fields: [resolvedBy], references: [id], onDelete: Restrict)
}

model AuditEvent {
  id        String   @id @default(uuid())
  userId    String
  marketId  String?
  action    String
  details   Json?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  market Market? @relation(fields: [marketId], references: [id], onDelete: SetNull)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
